# Copy this file to .env and customize the values as needed.
RUSTFS_ACCESS_KEY=ICEBERGADMIN
RUSTFS_SECRET_KEY=change-this-local-secret
WAREHOUSE_BUCKET=warehouse

# PyIceberg reads these overrides when they are exported in the shell.
PYICEBERG_CATALOG__LOCAL__URI=http://localhost:8181
PYICEBERG_CATALOG__LOCAL__WAREHOUSE=s3://warehouse/iceberg
PYICEBERG_CATALOG__LOCAL__S3__ENDPOINT=http://localhost:9000
PYICEBERG_CATALOG__LOCAL__S3__ACCESS_KEY_ID=ICEBERGADMIN
PYICEBERG_CATALOG__LOCAL__S3__SECRET_ACCESS_KEY=change-this-local-secret
